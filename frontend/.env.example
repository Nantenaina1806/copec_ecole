VITE_API_URL=http://localhost:4000/api

# URL publique utilisée par les QR de vérification des bulletins.
# En production, mettre l'URL réellement accessible depuis le téléphone qui scanne le QR.
VITE_PUBLIC_APP_URL=http://localhost:5173

# COPEC V10 deployment mode: demo limits external communication; production removes demo quotas.
COPEC_MODE=demo
DEMO_EMAIL_DAILY_LIMIT=20
DEMO_WHATSAPP_DAILY_LIMIT=5
BACKUP_AUTO=false
BACKUP_RETENTION_DAYS=30
COPEC_BACKUP_DIR=./backups
ALLOW_DB_RESTORE=false
