PORT=4000
NODE_ENV=development
APP_TIMEZONE=Indian/Antananarivo
APP_LOCALE=fr-FR

# ============================================================
# --- PostgreSQL ---
# ============================================================
# Option 1 (Neon / cloud) — mahazatra kokoa amin ny production :
# Renseignez DATABASE_URL ary avelao banga ny PG* etsy ambany (tsy ampiasaina raha misy DATABASE_URL).
# Alao ny "Connection string" ao console.neon.tech > ny projet > Connect > Connection string.
# Ohatra: postgresql://user:password@ep-xxx-pooler.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host.aws.neon.tech/dbname?sslmode=require

# Option 2 (PostgreSQL local, na hijerena/hanovana amin pgAdmin) :
# Ampiasaina IHANY raha BANGA ny DATABASE_URL etsy ambony.
# Ireto ireo paramètre ampiasainao koa raha mampiasa pgAdmin (Register > Server) mba hijerena
# ny base local: Host name/address = PGHOST, Port = PGPORT, Maintenance database = PGDATABASE,
# Username = PGUSER, Password = PGPASSWORD.
# NB: raha DATABASE_URL (Neon) no ampiasainao ho an ny appli, azonao atao ihany koa ny mampiasa
# io connection string io mivantana ao amin pgAdmin (Register > Server > Connection > 
# "Connect now?" tsindrio Cancel, dia amin ny tab Parameters ampio ny host/port/db/user/password
# nalaina avy ao amin ny DATABASE_URL, na ampiasao ny "Add Server" > paste ny host any amin
# Connection > Host name/address, ary asio sslmode=require ao amin ny Parameters > SSL mode = Require).
PGHOST=localhost
PGPORT=5432
PGDATABASE=gestion_copec
PGUSER=postgres
PGPASSWORD=changez_moi

# JWT
JWT_SECRET=changez_ce_secret_en_production
JWT_EXPIRES_IN=8h

GROQ_API_KEY=votre_cle_groq_ici
GROQ_MODEL=openai/gpt-oss-120b

# CORS
FRONTEND_URL=http://localhost:5173

# Secret de signature des QR de vérification des bulletins.
BULLETIN_QR_SECRET=changez_ce_secret_long_et_aleatoire
# URL publique du frontend utilisée dans les QR imprimés.
PUBLIC_APP_URL=http://localhost:5173

# ===== Sécurité / communications réelles =====
# Frontend URL utilisée dans les liens de récupération (déjà définie dans CORS ci-dessus)
# E-mail: Resend (https://resend.com) — ne jamais committer la clé réelle
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=COPEC <noreply@votre-domaine.mg>
# WhatsApp Cloud API Meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Optionnel : template WhatsApp Business approuvé par Meta. Si défini, le message est envoyé comme template avec le contenu comme variable 1.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr

# COPEC V10 deployment mode: demo limits external communication; production removes demo quotas.
COPEC_MODE=demo
DEMO_EMAIL_DAILY_LIMIT=20
DEMO_WHATSAPP_DAILY_LIMIT=5
BACKUP_AUTO=false
BACKUP_RETENTION_DAYS=30
COPEC_BACKUP_DIR=./backups
ALLOW_DB_RESTORE=false

# ============================================================
# COPEC OFFLINE / ONLINE — Synchronisation automatique
# ============================================================
# Pour le serveur LOCAL de l'école :
SYNC_ENABLED=true
SYNC_DEVICE_ID=LOCAL-SERVER
SYNC_INTERVAL_MS=15000
# URL PostgreSQL Neon centrale (laisser vide si mode local uniquement)
CENTRAL_DATABASE_URL=

# Pour un backend connecté directement à NEON comme serveur CENTRAL :
# SYNC_ENABLED=false
# SYNC_DEVICE_ID=CENTRAL-SERVER
